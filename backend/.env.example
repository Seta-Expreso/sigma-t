# ============================================
# SIGMA-T - BACKEND CONFIGURATION
# ============================================
# Copiar este archivo a .env y completar con los valores reales
# ============================================

# ─────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# BASE DE DATOS (POSTGRESQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=  # ⚠️ OBLIGATORIO en producción
DB_NAME=sigma_t

# ─────────────────────────────────────────────
# SEGURIDAD
# ─────────────────────────────────────────────
CORS_ORIGIN=*  # En producción: https://tu-dominio.com
JWT_SECRET=    # ⚠️ OBLIGATORIO - Generar una clave segura

# ─────────────────────────────────────────────
# SERVICIOS EXTERNOS
# ─────────────────────────────────────────────
AEROVARADERO_URL=https://www.aerovaradero.com.cu/payment/
AEROVARADERO_TIMEOUT=30000
AEROVARADERO_RETRIES=3

# ─────────────────────────────────────────────
# AUTOMATIZACIÓN DE ADUANA (4 horarios)
# ─────────────────────────────────────────────
AUTOMATION_SCHEDULE_1="0 8 * * *"   # 8:00 AM
AUTOMATION_SCHEDULE_2="0 12 * * *"  # 12:00 PM
AUTOMATION_SCHEDULE_3="0 16 * * *"  # 4:00 PM
AUTOMATION_SCHEDULE_4="0 0 * * *"   # 12:00 AM

# ─────────────────────────────────────────────
# PARÁMETROS POR DEFECTO
# ─────────────────────────────────────────────
DEFAULT_TASA_CAMBIO=240.00
DEFAULT_PRECIO_GASOLINA=180.00
DEFAULT_PRECIO_DIESEL=160.00
DEFAULT_COSTO_MANTENIMIENTO_POR_KM=15.00
DEFAULT_COSTO_NEUMATICO_POR_KM=5.00
DEFAULT_COSTO_DEPRECIACION_POR_KM=8.00
DEFAULT_COSTO_SEGURO_POR_KM=3.00
DEFAULT_COSTO_ADMINISTRATIVO_POR_KM=4.00
DEFAULT_COSTO_IMPUESTO_POR_KM=2.00