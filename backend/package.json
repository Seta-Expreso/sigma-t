{
  "name": "@sigmateam/backend",
  "version": "0.1.0",
  "description": "Backend API para SIGMA-T - Sistema Integral de Gestión para MiPYME de Transporte",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "docs": "typedoc src/**/*.ts"
  },
  "dependencies": {
    "express": "^5.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "xlsx": "^0.18.5",
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "winston": "^3.17.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}